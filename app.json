{
  "expo": {
    "name": "Garage Pulse",
    "slug": "garage-pulse",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/transFavi.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/transFavi.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.garagepulse.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/transFavi.png",
        "backgroundColor": "#FAFAFA"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dctechs.garagepulse",
      "versionCode": 5,
      "permissions": [
        "INTERNET",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/GPfavi.png"
    },
    "plugins": [
      [
        "expo-build-properties"
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "db68f503-aa06-4de1-b4ed-78090ec866f0"
      }
    },
    "owner": "dinsoncd"
  }
}
